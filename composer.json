{
    "name": "slpxxv/php-xmldsig",
    "description": "XML Digital Signature (XMLDSig) signing and verification built on ext-dom and ext-openssl.",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "xmldsig",
        "xml",
        "signature",
        "digital signature",
        "c14n",
        "x509",
        "rsa",
        "ecdsa",
        "saml"
    ],
    "homepage": "https://github.com/slpxxv/php-xmldsig",
    "authors": [
        {
            "name": "Dominik Szamburski"
        }
    ],
    "support": {
        "issues": "https://github.com/slpxxv/php-xmldsig/issues",
        "source": "https://github.com/slpxxv/php-xmldsig"
    },
    "require": {
        "php": "^8.2",
        "ext-dom": "*",
        "ext-openssl": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "robrichards/xmlseclibs": "^4.0",
        "squizlabs/php_codesniffer": "^3.10",
        "vimeo/psalm": "^6.0"
    },
    "autoload": {
        "psr-4": {
            "XmlDSig\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "XmlDSigTests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "platform": {
            "php": "8.2.27"
        },
        "sort-packages": true
    },
    "scripts": {
        "lint-check": "phpcs",
        "lint-fix": "phpcbf",
        "static-analysis": "psalm --shepherd --stats",
        "test": "phpunit"
    }
}
