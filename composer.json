{
    "name": "sxbrsky/xmldsig",
    "license": "MIT",
    "type": "library",
    "require": {
        "php": "^8.2",
        "ext-dom": "*",
        "ext-openssl": "*",
        "nuldark/stdlib": "^2.3",
        "starkbank/ecdsa": "^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "squizlabs/php_codesniffer": "^3.10",
        "vimeo/psalm": "^6.0"
    },
    "autoload": {
        "psr-4": {
            "XmlDSig\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "XmlDSigTests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "platform": {
            "php": "8.2.27"
        },
        "sort-packages": true
    },
    "scripts": {
        "lint-check": "phpcs",
        "lint-fix": "phpcbf",
        "static-analysis": "psalm --shepherd --stats",
        "test": "phpunit"
    }
}
